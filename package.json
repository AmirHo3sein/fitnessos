{
  "name": "fitnessos",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "bundle:budget": "node tools/bundle-budget.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm audit && pnpm tokens:check && pnpm color:contrast && pnpm copy:register && pnpm test:unit && pnpm test:integration && pnpm test:component",
    "color:contrast": "node tools/color/contrast-report.mjs",
    "color:lint": "node tools/color/lint-usage.mjs",
    "conformance": "pnpm --filter @fitnessos/conformance test:conformance",
    "conformance:coverage": "node tools/conformance/coverage.mjs",
    "contracts:generate": "turbo run contracts:generate",
    "copy:register": "node tools/copy/register.mjs",
    "dev:api": "pnpm --filter @fitnessos/stub-api start",
    "e2e:critical": "pnpm --filter @fitnessos/web e2e:critical",
    "e2e:full": "pnpm --filter @fitnessos/web e2e:full",
    "gen": "plop --plopfile tools/generators/plopfile.mjs",
    "gen:context": "plop --plopfile tools/generators/plopfile.mjs context",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.cjs",
    "lint": "turbo run lint && pnpm lint:boundaries && pnpm color:lint",
    "lint:boundaries": "depcruise --config packages/config/dependency-cruiser.cjs packages apps",
    "test": "turbo run test",
    "test:component": "turbo run test:component",
    "test:integration": "turbo run test:integration",
    "test:unit": "turbo run test:unit",
    "tokens:build": "node tools/color/emit.mjs",
    "tokens:check": "node tools/color/check-tokens.mjs",
    "typecheck": "turbo run typecheck",
    "audit": "pnpm audit --audit-level=high",
    "check:full": "pnpm check && pnpm e2e:critical"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "dependency-cruiser": "^16.5.0",
    "eslint": "^9.14.0",
    "plop": "^4.0.1",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6",
    "wait-on": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0",
      "js-yaml": ">=4.3.1",
      "vite": ">=6.4.3",
      "esbuild": ">=0.25.0",
      "tmp": ">=0.2.6",
      "uuid": ">=11.1.1"
    }
  }
}
