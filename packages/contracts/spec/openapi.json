{
  "openapi": "3.1.0",
  "info": {
    "title": "FitnessOS API",
    "version": "0.1.0",
    "description": "STOPGAP per ADR-0026. This file is hand-authored and committed here until the backend publishes @fitnessos/api-spec as a versioned package. Spec-first: the specification is the contract; the Rust handlers conform to it."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Same-origin per ADR-0025"
    }
  ],
  "tags": [
    {
      "name": "athlete",
      "description": "Athlete ownership root"
    },
    {
      "name": "auth",
      "description": "Session lifecycle"
    }
  ],
  "paths": {
    "/athletes/me": {
      "get": {
        "operationId": "getMyAthlete",
        "tags": [
          "athlete"
        ],
        "summary": "The calling person's athlete record",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Athlete"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "tags": [
          "auth"
        ],
        "summary": "Rotate the refresh token and reissue the access cookie",
        "description": "Strict rotation: the presented token is revoked. Concurrent callers MUST be serialised client-side or they will revoke each other's freshly issued session.",
        "responses": {
          "204": {
            "description": "cookies reissued"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/request-code": {
      "post": {
        "operationId": "requestCode",
        "tags": [
          "auth"
        ],
        "summary": "Send a one-time code by SMS",
        "description": "Rate limited per IP and per phone. Returns the same shape whether or not the phone is registered \u2014 a differing response would make this an account-enumeration oracle.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestCodeBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "code dispatched",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestCodeResult"
                }
              }
            }
          },
          "429": {
            "description": "rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify-code": {
      "post": {
        "operationId": "verifyCode",
        "tags": [
          "auth"
        ],
        "summary": "Exchange a one-time code for a session",
        "description": "On success sets the access and refresh cookies (httpOnly, SameSite=Lax). No token is ever returned in the body \u2014 a token readable from JS is a token exfiltrable by XSS.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyCodeBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "session established",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyCodeResult"
                }
              }
            }
          },
          "400": {
            "description": "code incorrect or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "too many attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/athletes/me/onboarding": {
      "put": {
        "operationId": "completeOnboarding",
        "tags": [
          "athlete"
        ],
        "summary": "Record the athlete's training identity and availability",
        "description": "PUT rather than POST: submitting the same body twice must leave the athlete in the same state. Onboarding is a form a user will resubmit after a network hiccup, and an idempotent verb is what makes that safe without a client-generated request id.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteOnboardingBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Athlete"
                }
              }
            }
          },
          "400": {
            "description": "invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/goals": {
      "get": {
        "operationId": "listMyGoals",
        "tags": [
          "goal"
        ],
        "summary": "The calling athlete's goals",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Goal"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "declareGoal",
        "tags": [
          "goal"
        ],
        "summary": "Declare a goal",
        "description": "POST rather than PUT: declaring a goal creates a new one each time, and two goals with the same wording are legitimately different goals declared at different moments.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeclareGoalBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "declared",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Goal"
                }
              }
            }
          },
          "400": {
            "description": "invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/programs/current": {
      "get": {
        "operationId": "getCurrentProgram",
        "tags": [
          "prescription"
        ],
        "summary": "The athlete's current programme and its current version",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Program"
                }
              }
            }
          },
          "204": {
            "description": "no programme yet"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/sessions/upcoming": {
      "get": {
        "operationId": "listUpcomingSessions",
        "tags": [
          "execution"
        ],
        "summary": "Prescribed sessions not yet performed",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PrescribedSession"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/sessions/performed": {
      "post": {
        "operationId": "logSession",
        "tags": [
          "execution"
        ],
        "summary": "Record what the athlete actually did",
        "description": "Idempotent by client-supplied id. A repeat of an id already stored MUST return 409 with the stored record, never a second row -- offline replay is at-least-once. 409 also occurs when another device logged this prescribed session first; the client preserves its own copy and surfaces the difference (ADR-0033).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogSessionBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerformedSession"
                }
              }
            }
          },
          "409": {
            "description": "already logged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerformedSession"
                }
              }
            }
          },
          "400": {
            "description": "invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/programs/{programId}/versions": {
      "post": {
        "operationId": "reviseProgram",
        "tags": [
          "prescription"
        ],
        "summary": "Create the next version of a programme",
        "description": "Idempotent by client-supplied version id; concurrency-checked by baseVersionId. A repeat of a stored id returns 200 with that version. A stale baseVersionId returns 409 with the CURRENT program, so the client can show the author what changed instead of silently discarding one of the two edits (ADR-0033).",
        "parameters": [
          {
            "name": "programId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviseProgramBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "revised",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Program"
                }
              }
            }
          },
          "200": {
            "description": "this revision was already stored -- the same id replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Program"
                }
              }
            }
          },
          "409": {
            "description": "the base version is no longer current; body is the programme as it stands now",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Program"
                }
              }
            }
          },
          "400": {
            "description": "invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "no valid session",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "stable machine-readable code"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Athlete": {
        "type": "object",
        "required": [
          "id",
          "personId",
          "status",
          "trainingIdentity",
          "availability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "personId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "dormant",
              "archived"
            ]
          },
          "trainingIdentity": {
            "$ref": "#/components/schemas/TrainingIdentity"
          },
          "availability": {
            "$ref": "#/components/schemas/Availability"
          }
        }
      },
      "TrainingIdentity": {
        "type": "object",
        "required": [
          "experienceLevel",
          "disciplines"
        ],
        "properties": {
          "trainingAgeMonths": {
            "type": "integer",
            "minimum": 0
          },
          "experienceLevel": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "disciplines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Availability": {
        "type": "object",
        "required": [
          "daysPerWeek",
          "equipmentAccess"
        ],
        "properties": {
          "daysPerWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "sessionCeilingSeconds": {
            "type": "integer",
            "minimum": 600,
            "description": "Duration in seconds. Unit is explicit in the name because N11 forbids an ambiguous magnitude."
          },
          "equipmentAccess": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RequestCodeBody": {
        "type": "object",
        "required": [
          "phone"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+989[0-9]{9}$",
            "description": "E.164. The client normalises Persian/Arabic-Indic digits and local prefixes before sending; the server receives one canonical form only."
          }
        }
      },
      "RequestCodeResult": {
        "type": "object",
        "required": [
          "retryAfterSeconds",
          "codeLength"
        ],
        "properties": {
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": 0,
            "description": "Seconds until another code may be requested. Unit is explicit in the name because N11 forbids an ambiguous magnitude. Server-authoritative: the client must not compute its own cooldown."
          },
          "codeLength": {
            "type": "integer",
            "minimum": 4,
            "maximum": 8,
            "description": "So the client does not hardcode a length the server can change."
          }
        }
      },
      "VerifyCodeBody": {
        "type": "object",
        "required": [
          "phone",
          "code"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+989[0-9]{9}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{4,8}$"
          }
        }
      },
      "VerifyCodeResult": {
        "type": "object",
        "required": [
          "personId",
          "isNewPerson"
        ],
        "properties": {
          "personId": {
            "type": "string",
            "format": "uuid"
          },
          "isNewPerson": {
            "type": "boolean",
            "description": "True when this verification created the person. The client routes to onboarding rather than the dashboard."
          }
        }
      },
      "CompleteOnboardingBody": {
        "type": "object",
        "required": [
          "trainingIdentity",
          "availability"
        ],
        "properties": {
          "trainingIdentity": {
            "$ref": "#/components/schemas/TrainingIdentity"
          },
          "availability": {
            "$ref": "#/components/schemas/Availability"
          }
        }
      },
      "Goal": {
        "type": "object",
        "required": [
          "id",
          "athleteId",
          "intent",
          "declaredOn",
          "cadenceDays"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "athleteId": {
            "type": "string",
            "format": "uuid"
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The athlete's own words, verbatim. Never a normalised or translated form -- losing the phrasing is not recoverable."
          },
          "declaredOn": {
            "type": "string",
            "format": "date",
            "description": "ISO date, no time. The declaration is a calendar fact in the athlete's zone."
          },
          "horizon": {
            "type": "string",
            "format": "date",
            "description": "Absent means open-ended, which is a valid answer."
          },
          "cadenceDays": {
            "type": "integer",
            "minimum": 7,
            "maximum": 365,
            "description": "Evaluation cadence. NOT a status: staleness and expiry are derived from this plus a date (ADR-0006), never stored."
          }
        }
      },
      "DeclareGoalBody": {
        "type": "object",
        "required": [
          "intent",
          "cadenceDays"
        ],
        "properties": {
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "horizon": {
            "type": "string",
            "format": "date"
          },
          "cadenceDays": {
            "type": "integer",
            "minimum": 7,
            "maximum": 365
          }
        }
      },
      "ProgressionIntent": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "fixed",
              "linear",
              "autoregulated"
            ]
          },
          "ratePercent": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 20,
            "description": "Percent per cycle. Present only for kind=linear. Percent rather than absolute because the same increment is trivial for one athlete and impossible for another."
          }
        }
      },
      "Block": {
        "type": "object",
        "required": [
          "id",
          "name",
          "order",
          "progressionIntent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based. Orders across a version must be exactly 0..n-1, each once."
          },
          "progressionIntent": {
            "$ref": "#/components/schemas/ProgressionIntent"
          }
        }
      },
      "ServesGoal": {
        "type": "object",
        "required": [
          "goalId"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "format": "uuid"
          },
          "rationale": {
            "type": "string"
          }
        },
        "description": "States current purpose. NEVER an input to outcome evaluation (ADR-0008)."
      },
      "AuthoringDecision": {
        "type": "object",
        "required": [
          "decidedBy",
          "proposedBy"
        ],
        "properties": {
          "decidedBy": {
            "type": "string"
          },
          "proposedBy": {
            "type": "string",
            "enum": [
              "human",
              "assistant"
            ],
            "description": "Separate from decidedBy: an AI-proposed programme accepted by a coach was DECIDED by the coach. Collapsing them loses the fact that makes ADR-0003 auditable."
          },
          "rationale": {
            "type": "string"
          }
        }
      },
      "ProgramVersion": {
        "type": "object",
        "required": [
          "id",
          "programId",
          "versionNumber",
          "blocks",
          "authoringDecision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "programId": {
            "type": "string",
            "format": "uuid"
          },
          "versionNumber": {
            "type": "integer",
            "minimum": 1
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Block"
            }
          },
          "servesGoal": {
            "$ref": "#/components/schemas/ServesGoal"
          },
          "authoringDecision": {
            "$ref": "#/components/schemas/AuthoringDecision"
          }
        }
      },
      "Program": {
        "type": "object",
        "required": [
          "id",
          "athleteId",
          "title",
          "currentVersion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "athleteId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "$ref": "#/components/schemas/ProgramVersion"
          }
        },
        "description": "The LINEAGE plus its current structure. Program and ProgramVersion are separate aggregates (ADR-0008); this envelope is a read projection, not a merge."
      },
      "ScreeningVerdict": {
        "type": "object",
        "required": [
          "level",
          "basisWithheld"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "clear",
              "modified",
              "blocked"
            ]
          },
          "basis": {
            "type": "string",
            "description": "Why. Absent when consent-gated (ADR-0002/0014), which is NOT the same as absent because there is no reason -- see basisWithheld."
          },
          "basisWithheld": {
            "type": "boolean",
            "description": "True when a basis exists but this viewer may not see it. Distinguishes the two reasons basis can be absent."
          }
        }
      },
      "PrescribedItem": {
        "type": "object",
        "required": [
          "id",
          "movementName",
          "order",
          "sets",
          "reps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "movementName": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "sets": {
            "type": "integer",
            "minimum": 1
          },
          "reps": {
            "type": "integer",
            "minimum": 1
          },
          "loadKg": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Resolved load in kilograms. ABSENT for bodyweight or time-based work -- never 0, which is what an unresolved progression writes."
          }
        }
      },
      "PrescribedSession": {
        "type": "object",
        "required": [
          "id",
          "programVersionId",
          "scheduledFor",
          "items",
          "screening"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "programVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "scheduledFor": {
            "type": "string",
            "format": "date"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/PrescribedItem"
            }
          },
          "screening": {
            "$ref": "#/components/schemas/ScreeningVerdict"
          }
        },
        "description": "Required screening is ADR-0021: a PrescribedSession cannot exist without a verdict covering its final RESOLVED dose. Screening an intent is worthless -- an intent has no numbers to screen."
      },
      "PerformedSet": {
        "type": "object",
        "required": [
          "id",
          "prescribedItemId",
          "setNumber",
          "reps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "prescribedItemId": {
            "type": "string",
            "format": "uuid"
          },
          "setNumber": {
            "type": "integer",
            "minimum": 1
          },
          "reps": {
            "type": "integer",
            "minimum": 1
          },
          "loadKg": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Absent for bodyweight. Never 0."
          },
          "rpe": {
            "type": "number",
            "minimum": 1,
            "maximum": 10,
            "multipleOf": 0.5
          }
        }
      },
      "LogSessionBody": {
        "type": "object",
        "required": [
          "id",
          "prescribedSessionId",
          "performedOn",
          "sets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "CLIENT-generated UUIDv7 (D-10). The idempotency key: a queued log replayed after a lost response arrives with the same id, and the server MUST answer 409 rather than creating a second record. Offline replay is at-least-once and this is what makes it safe."
          },
          "prescribedSessionId": {
            "type": "string",
            "format": "uuid"
          },
          "performedOn": {
            "type": "string",
            "format": "date",
            "description": "Independent of the prescription's scheduledFor. Monday's session may be performed on Tuesday."
          },
          "sets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/PerformedSet"
            }
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "PerformedSession": {
        "type": "object",
        "required": [
          "id",
          "prescribedSessionId",
          "performedOn",
          "sets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "prescribedSessionId": {
            "type": "string",
            "format": "uuid"
          },
          "performedOn": {
            "type": "string",
            "format": "date"
          },
          "sets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/PerformedSet"
            }
          },
          "note": {
            "type": "string"
          }
        }
      },
      "ReviseProgramBody": {
        "type": "object",
        "required": [
          "id",
          "baseVersionId",
          "blocks",
          "authoringDecision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "CLIENT-generated id for the NEW version (D-10). The idempotency key: a revision replayed after a lost response arrives with the same id, and the server MUST return the stored version with 200 rather than creating a second one. Without it, a coach who loses the response and retries silently creates two versions and the athlete's programme jumps two numbers."
          },
          "baseVersionId": {
            "type": "string",
            "format": "uuid",
            "description": "The version this revision was edited FROM. If it is no longer current, another author revised in the meantime and the server MUST answer 409 with the version that is current now -- overwriting would discard their work with no trace. Optimistic concurrency rather than locking, because a coach with a builder open for an hour must not hold a lock for an hour."
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Block"
            }
          },
          "servesGoal": {
            "$ref": "#/components/schemas/ServesGoal"
          },
          "authoringDecision": {
            "$ref": "#/components/schemas/AuthoringDecision"
          }
        },
        "description": "A revision creates a NEW version and leaves the old one untouched (ADR-0008): a structure an athlete has already followed cannot be edited without making every PerformedSession against it unreadable. versionNumber is assigned by the server, not sent -- it is derived from the lineage and a client that guessed it would race another author."
      }
    }
  }
}
